---
import { getEntry } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import Workspace from '../components/Workspace.astro';

const about = await getEntry('about', 'ko');

if (!about) {
  throw new Error('Required content entry "about/ko" is missing.');
}
---

<Layout
  title="김영빈 | Backend Engineer"
  lang="ko"
  description={about.data.tagline}
>
  <Workspace lang="ko" />
</Layout>
